# Grontia — local environment variables
# Copy to orchestration/airflow/.env (never commit the real .env).
# Defaults match orchestration/airflow/docker-compose.yml.

# S3-compatible storage (SeaweedFS locally; names kept from the MinIO era)
# Use http://s3:9000 inside Docker and http://localhost:9000 from the host
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# dbt — local DuckDB file (target: dev)
GRONTIA_DUCKDB_PATH=/tmp/grontia_dev.duckdb

# dbt — MotherDuck (target: motherduck), token from https://app.motherduck.com
MOTHERDUCK_TOKEN=

# Airflow (docker-compose reads these from orchestration/airflow/.env).
# Local defaults are fine; set real values before exposing the stack (e.g. on a VPS).
# AIRFLOW_ADMIN_PASSWORD only applies when the admin user is first created.
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_JWT_SECRET=grontia-local-dev-jwt-secret
# dbt target used by DAG 40: dev (DuckDB file in the warehouse volume) or motherduck
GRONTIA_DBT_TARGET=dev
